# ---------------------------------------------------------------------------
# Incident Response Automation — ignore rules
#
# Create this file BEFORE `git init` and the first commit. See AGENTS.md §2.5
# and §6. Never remove a line here to make a file tracked.
# ---------------------------------------------------------------------------

# Runtime state — incidents, evidence, custody logs, run journals
data/

# Generated reports
reports/

# Optional real memory images. Large (100 MB - 1 GB+), operator-supplied.
# NEVER commit a memory image. See docs/SECURITY.md §3.
fixtures/memory/

# SQLite (WAL mode creates -wal / -shm siblings)
*.db
*.db-wal
*.db-shm

